<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>nl.gewoonsander.food-capture</string>
  <key>ProgramArguments</key><array><string>/bin/zsh</string><string>-lc</string><string>source "$HOME/.config/gewoonsander/env" 2&gt;/dev/null || true; python3 "__ROOT__/Expansions/mypka-cockpit/scripts/watch-food-inbox.py"</string></array>
