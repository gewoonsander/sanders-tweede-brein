<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ACTIEF - geinstalleerd op de Mac mini, 2026-08-17 (het bestand lag hier al sinds 16-08
  met een "ACTIEF"-comment, maar is toen nooit daadwerkelijk gebootstrapt — ontdekt tijdens
  een dagstart-vervolgvraag op 17-08).

  Draait dagelijks om 07:00 lokaal scripts/youtube-samenvatting-ochtend.sh, dat voor elk
  gevolgd kanaal in config/youtube-kanalen.json checkt op nieuwe video's via de bestaande
  /transcribeer-skill en ze samenvat. Samenvattingsmethode staat in
  config/youtube-kanalen.json -> samenvatting_methode: momenteel "abonnement" (lokale
  headless Claude Code CLI, geen aparte kosten) — niet de Haiku-API die in een eerdere
  versie van dit ontwerp stond. Schrijft weg als Outer World-item + dagstart-queue-entry.
  Zie Deliverables/2026-08-16-youtube-kanaal-samenvatting-design.md voor het volledige ontwerp.

  ExitTimeOut ruimer dan adc-verslag-ochtend (1800s i.p.v. 600s): een video zonder
  ondertitels kan via de Whisper-terugval een paar minuten kosten, en er kunnen meerdere
  nieuwe video's in één run zitten.

  StandardInPath toegevoegd 2026-08-17, proactief overgenomen van de adc-verslag-ochtend-
  bugfix diezelfde dag: de headless `claude -p`-aanroep (bij samenvatting_methode:
  "abonnement") bleef daar onder launchd urenlang hangen zonder expliciete stdin-redirect.
  Zelfde onderliggende mechanisme hier, dus hier ook direct toegepast i.p.v. te wachten tot
  dit script hetzelfde probleem zelf demonstreert.

  Handmatig draaien zonder op 07:00 te wachten:
    launchctl kickstart gui/$(id -u)/nl.gewoonsander.youtube-samenvatting-ochtend

  Tijdstip wijzigen: pas StartCalendarInterval aan (Hour 0-23, Minute 0-59), daarna:
    launchctl bootout gui/$(id -u)/nl.gewoonsander.youtube-samenvatting-ochtend
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/nl.gewoonsander.youtube-samenvatting-ochtend.plist

  Uitzetten:
    launchctl bootout gui/$(id -u)/nl.gewoonsander.youtube-samenvatting-ochtend
    rm ~/Library/LaunchAgents/nl.gewoonsander.youtube-samenvatting-ochtend.plist
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>nl.gewoonsander.youtube-samenvatting-ochtend</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/sandervanockenburg-zwaan/Documents/sanders-tweede-brein/scripts/youtube-samenvatting-ochtend.sh</string>
	</array>

	<key>WorkingDirectory</key>
	<string>/Users/sandervanockenburg-zwaan/Documents/sanders-tweede-brein</string>

	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>7</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>

	<key>RunAtLoad</key>
	<false/>

	<key>ProcessType</key>
	<string>Background</string>

	<key>ExitTimeOut</key>
	<integer>1800</integer>

	<key>StandardInPath</key>
	<string>/dev/null</string>

	<key>StandardOutPath</key>
	<string>/Users/sandervanockenburg-zwaan/Library/Logs/youtube-samenvatting-ochtend.log</string>

	<key>StandardErrorPath</key>
	<string>/Users/sandervanockenburg-zwaan/Library/Logs/youtube-samenvatting-ochtend.err.log</string>
</dict>
</plist>
