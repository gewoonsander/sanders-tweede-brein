<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ACTIEF - geinstalleerd op deze Mac mini, 2026-08-11.
  Herzien 2026-08-17 (Daedalus) na de stille vastloper van 12, 13 en 17 augustus.

  Draait dagelijks om 07:00 lokaal scripts/adc-verslag-ochtend.sh, dat via de Claude Code
  CLI (headless, -p) checkt of er gisteren een ADC Regio Oost toernooi was en zo ja het
  Facebook-verslag genereert + lokaal committet. Bewust lokaal (geen Anthropic cloud-
  routine) om vendor lock-in te vermijden en omdat de bestaande git-toegang op deze Mac
  al werkt, zonder een aparte GitHub-cloud-koppeling.

  WAAROM /bin/bash EN NIET /opt/homebrew/bin/node (root cause 2026-08-17):
  LaunchAgents hebben op deze Mac geen TCC-toegang tot ~/Documents. Apple-gesigneerde
  binaries krijgen daar netjes EPERM; node en de losse claude-versiebinary krijgen een
  toestemmingsdialoog en BLOKKEREN oneindig zolang niemand die wegklikt. Een hangend
  proces houdt de job "running", waardoor launchd elk volgend 07:00-interval stilzwijgend
  oversloeg - vandaar meerdere gemiste dagen achter elkaar.
  Het script draait de CLI daarom via het app-bundle-pad
  (~/.local/share/claude/ClaudeCode.app/Contents/MacOS/claude). Dat bundle heeft een
  stabiele, door Anthropic gesigneerde identiteit (com.anthropic.claude-code) met
  Volledige Schijftoegang, en die grant overleeft de auto-updates van de CLI.
  Node zit niet meer in het pad. Zie de kop van scripts/adc-verslag-ochtend.sh.

  WorkingDirectory staat bewust op /tmp: laat launchd niet zelf naar een TCC-beschermde
  map chdir'en. Het script doet de cd naar de repo zelf, na een leesbaarheidscheck.

  Handmatig draaien zonder op 07:00 te wachten:
    launchctl kickstart gui/$(id -u)/nl.gewoonsander.adc-verslag-ochtend

  Tijdstip wijzigen: pas StartCalendarInterval aan (Hour 0-23, Minute 0-59), daarna:
    launchctl bootout gui/$(id -u)/nl.gewoonsander.adc-verslag-ochtend
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/nl.gewoonsander.adc-verslag-ochtend.plist

  Uitzetten:
    launchctl bootout gui/$(id -u)/nl.gewoonsander.adc-verslag-ochtend
    rm ~/Library/LaunchAgents/nl.gewoonsander.adc-verslag-ochtend.plist
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>nl.gewoonsander.adc-verslag-ochtend</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/sandervanockenburg-zwaan/Documents/sanders-tweede-brein/scripts/adc-verslag-ochtend.sh</string>
	</array>

	<key>WorkingDirectory</key>
	<string>/tmp</string>

	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>7</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>

	<key>RunAtLoad</key>
	<false/>

	<key>ProcessType</key>
	<string>Background</string>

	<key>ExitTimeOut</key>
	<integer>600</integer>

	<!-- StandardInPath: de headless `claude -p`-aanroep wacht onder launchd anders op
	     stdin en krijgt nooit EOF. Het script redirect stdin zelf ook al naar /dev/null;
	     dit is de gordel naast de bretels. Inzicht uit de parallelle sessie van 17-08. -->
	<key>StandardInPath</key>
	<string>/dev/null</string>

	<key>StandardOutPath</key>
	<string>/Users/sandervanockenburg-zwaan/Library/Logs/adc-verslag-ochtend.log</string>

	<key>StandardErrorPath</key>
	<string>/Users/sandervanockenburg-zwaan/Library/Logs/adc-verslag-ochtend.err.log</string>
</dict>
</plist>
