<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ACTIEF - geinstalleerd op de Mac mini, 2026-08-11. StandardInPath toegevoegd 2026-08-17
  (voorheen alleen rechtstreeks op de Mac mini bewerkt, nu ook hier in de repo als bron).

  Draait dagelijks om 07:00 lokaal scripts/adc-verslag-ochtend.mjs (node-wrapper, roept
  scripts/adc-verslag-ochtend.prompt.md headless aan via de lokale Claude Code CLI), dat
  checkt of er gisteren een ADC Regio Oost toernooi was en zo ja het Facebook-verslag
  genereert + lokaal committet, en (sinds WS-009) ook of er vandaag een toernooi gepland
  staat voor de vooraankondiging. Bewust lokaal (geen Anthropic cloud-routine) om vendor
  lock-in te vermijden en omdat de bestaande git-toegang op deze Mac al werkt, zonder een
  aparte GitHub-cloud-koppeling.

  BUGFIX 2026-08-17 — StandardInPath: de headless `claude -p`-aanroep bleef onder launchd
  soms urenlang hangen op 0% CPU (twee keer geconstateerd op 17-08). Gereproduceerd: dezelfde
  aanroep met stdin expliciet op /dev/null werkte binnen enkele seconden, zonder redirect
  bleef hij hangen. De CLI probeert kennelijk stdin te lezen (voor eventuele meegepipete
  input); onder launchd krijgt het proces zonder StandardInPath geen nette EOF op stdin en
  blijft daar voor altijd op wachten. execFileSync(..., {stdio: "inherit"}) in de .mjs geeft
  het kind-proces letterlijk de stdin van de LaunchAgent zelf door — vandaar dat dit hier
  moet worden opgelost, niet in het script. Zie het sessielog van 2026-08-17.

  Handmatig draaien zonder op 07:00 te wachten:
    launchctl kickstart gui/$(id -u)/nl.gewoonsander.adc-verslag-ochtend

  Tijdstip wijzigen: pas StartCalendarInterval aan (Hour 0-23, Minute 0-59), daarna:
    launchctl bootout gui/$(id -u)/nl.gewoonsander.adc-verslag-ochtend
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/nl.gewoonsander.adc-verslag-ochtend.plist

  Uitzetten:
    launchctl bootout gui/$(id -u)/nl.gewoonsander.adc-verslag-ochtend
    rm ~/Library/LaunchAgents/nl.gewoonsander.adc-verslag-ochtend.plist
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>nl.gewoonsander.adc-verslag-ochtend</string>

	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/node</string>
		<string>/Users/sandervanockenburg-zwaan/Documents/sanders-tweede-brein/scripts/adc-verslag-ochtend.mjs</string>
	</array>

	<key>WorkingDirectory</key>
	<string>/Users/sandervanockenburg-zwaan/Documents/sanders-tweede-brein</string>

	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>7</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>

	<key>RunAtLoad</key>
	<false/>

	<key>ProcessType</key>
	<string>Background</string>

	<key>ExitTimeOut</key>
	<integer>600</integer>

	<key>StandardInPath</key>
	<string>/dev/null</string>

	<key>StandardOutPath</key>
	<string>/Users/sandervanockenburg-zwaan/Library/Logs/adc-verslag-ochtend.log</string>

	<key>StandardErrorPath</key>
	<string>/Users/sandervanockenburg-zwaan/Library/Logs/adc-verslag-ochtend.err.log</string>
</dict>
</plist>
